<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2622D3EE">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <gradient android:angle="90" android:startColor="#2622D3EE" android:endColor="#338B5CF6" />
                    <stroke android:width="1dp" android:color="#5522D3EE" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#00000000" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
