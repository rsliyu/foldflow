<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2622D3EE">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true" android:drawable="@drawable/glass_glow_card" />
            <item>
                <shape>
                    <solid android:color="#0AFFFFFF" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
