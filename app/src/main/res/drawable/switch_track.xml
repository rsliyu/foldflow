<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <gradient android:angle="0" android:endColor="#9922D3EE" android:startColor="#998B5CF6" />
            <corners android:radius="999dp" />
            <size android:width="52dp" android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <corners android:radius="999dp" />
            <size android:width="52dp" android:height="30dp" />
        </shape>
    </item>
</selector>
