<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3322D3EE">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <gradient android:angle="0" android:startColor="#E68B5CF6" android:endColor="#E622D3EE" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/glass" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
