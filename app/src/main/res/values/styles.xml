<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorBackground">@color/ink_900</item>
        <item name="android:statusBarColor">@color/ink_950</item>
        <item name="android:navigationBarColor">@color/ink_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:colorPrimary">@color/violet</item>
        <item name="android:colorControlActivated">@color/cyan</item>
        <item name="android:colorControlNormal">@color/text_muted</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textColorHighlight">#6622D3EE</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="DialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/ink_850</item>
    </style>

    <!-- ===== 文字 ===== -->

    <style name="Text" />

    <style name="Text.Eyebrow">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- ===== 控件 ===== -->

    <style name="Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/button_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Button.Ghost" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/button_text_ghost</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Button.Small" parent="@style/Button.Ghost">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Chip" parent="@android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="NavTab" parent="@android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/nav_tab_bg</item>
        <item name="android:textColor">@color/nav_tab_tint</item>
        <item name="android:drawableTint">@color/nav_tab_tint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="SegTab" parent="@android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/nav_tab_bg</item>
        <item name="android:textColor">@color/nav_tab_tint</item>
        <item name="android:drawableTint">@color/nav_tab_tint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="Field" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Toggle" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:switchPadding">12dp</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/glass_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="PanelScroll">
        <item name="android:clipToPadding">false</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:paddingBottom">@dimen/panel_bottom_inset</item>
    </style>
</resources>
