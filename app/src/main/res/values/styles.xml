<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppField" parent="@android:style/Widget.Material.Spinner">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
    <style name="AppFilter" parent="@android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent_teal</item>
        <item name="android:statusBarColor">@color/header_navy</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="HeroButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">#ffffff</item>
        <item name="android:background">@drawable/button_hero</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">#ffffff</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="SecondaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">@color/accent_teal_dark</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="SmallTextButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#9fe3df</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="ChipButton" parent="@style/SecondaryButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="PanelTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="PanelHint">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="Panel">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/panel_background</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
