<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRatio"
    style="@style/PanelScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="内屏显示比例" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="改变应用在内屏上的显示方式。设置时应用会被重启；第一次修改前的比例会自动记下，可以随时恢复。" />

        <include
            android:id="@+id/targetRatio"
            layout="@layout/view_target_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <GridLayout
            android:id="@+id/ratioGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="@integer/ratio_columns"
            android:useDefaultMargins="false" />

        <EditText
            android:id="@+id/manualRatioInput"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="或输入自定义比例，例如 4:3、2.33"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <Switch
            android:id="@+id/relaunchSwitch"
            style="@style/Toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="只选一个应用时，设置后自动重新打开它" />

        <Button
            android:id="@+id/applyInnerRatioButton"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="应用到已选应用" />

        <Button
            android:id="@+id/restoreRatioButton"
            style="@style/Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="恢复已选应用的原比例" />
    </LinearLayout>
</ScrollView>
